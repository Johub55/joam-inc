{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available for sale",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "onSale": { "type": "boolean" },
        "cat": { "type": "string" },
        "emoji": { "type": "string" },
        "inStock": { "type": "boolean" }
      },
      "required": ["id", "name", "price", "cat", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "no": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "orderType": { "type": "string" },
        "identifier": { "type": "string" }
      },
      "required": ["no", "total", "status", "orderType", "identifier"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "User bank account",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "username": { "type": "string" },
        "balance": { "type": "number" }
      },
      "required": ["id", "username", "balance"]
    },
    "PosUser": {
      "title": "PosUser",
      "description": "POS User",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "username": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "username", "name"]
    },
    "HardwareTerminal": {
      "title": "HardwareTerminal",
      "description": "Realtime state relay between WerkPay POS web app and Raspberry Pi Pico W hardware pinpad",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["IDLE", "LINK", "CARD_SCANNED", "LINKED", "PAY", "SUBMITTED", "APPROVED", "DECLINED"],
          "maxLength": 32
        },
        "username": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "orderNo": { "type": "number" },
        "scannedUid": { "type": "string", "maxLength": 64 },
        "enteredPin": { "type": "string", "maxLength": 16 },
        "reason": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["status", "updatedAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of products"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders"
    },
    "bank_accounts/{accountId}": {
      "schema": "BankAccount",
      "description": "Collection of bank accounts"
    },
    "pos_users/{userId}": {
      "schema": "PosUser",
      "description": "Collection of POS users"
    },
    "hardware_terminals/{terminalId}": {
      "schema": "HardwareTerminal",
      "description": "Hardware pinpad terminal relay state documents"
    },
    "pos_settings/{settingId}": {
      "description": "Collection of POS settings"
    },
    "bank_transactions/{transactionId}": { "description": "Collection of bank transactions" },
    "cash_requests/{requestId}": { "description": "Collection of cash requests" },
    "chat_groups/{groupId}": { "description": "Collection of chat groups" },
    "coupons/{couponId}": { "description": "Collection of coupons" },
    "gift_cards/{cardId}": { "description": "Collection of gift cards" },
    "group_members/{memberId}": { "description": "Collection of group members" },
    "group_messages/{messageId}": { "description": "Collection of group messages" },
    "inventory/{itemId}": { "description": "Collection of inventory" },
    "loyalty_customers/{customerId}": { "description": "Collection of loyalty customers" },
    "phone_messages/{messageId}": { "description": "Collection of phone messages" },
    "pos_audit_logs/{logId}": { "description": "Collection of audit logs" },
    "pos_sessions/{sessionId}": { "description": "Collection of POS sessions" },
    "tv_presets/{presetId}": { "description": "Collection of TV presets" }
  }
}
